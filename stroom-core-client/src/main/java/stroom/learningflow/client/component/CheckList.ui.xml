<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- The Setup tab's quality checks, a row for every check, with Edit and a pager -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:b="urn:import:stroom.widget.button.client"
             xmlns:dg="urn:import:stroom.widget.datagrid.client">
    <dg:PagerPanel toolbarName="Quality check actions">
        <b:ToolbarButton ui:field="editButton" svg="EDIT" title="Edit the selected check" enabled="false"/>
        <dg:DataGrid ui:field="dataGrid" tableName="Quality checks"/>
    </dg:PagerPanel>
</ui:UiBinder>
