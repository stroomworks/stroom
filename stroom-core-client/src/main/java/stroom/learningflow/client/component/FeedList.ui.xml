<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- The feeds a Learning Flow document learns and translates, its Feeds tab (feed-list.css): a quick filter by
     name above a row each, with a button that opens its pipeline, saying where it stands; the pager's toolbar has
     the tab's auto refresh and the filter of which feeds to show -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:b="urn:import:stroom.widget.button.client"
             xmlns:dg="urn:import:stroom.widget.datagrid.client"
             xmlns:v="urn:import:stroom.widget.quickfilter.client">
    <v:QuickFilterPage ui:field="page" accessibleName="Filter pipelines by name">
        <dg:PagerPanel ui:field="pager" toolbarName="Feed list actions">
            <b:ToolbarToggleButton ui:field="autoRefreshButton" svg="AUTO_REFRESH"
                                   title="Auto Refresh: read the pipelines again every ten seconds" pressed="true"/>
            <b:ToolbarButton ui:field="filterButton" svg="FILTER" title="Filter Pipelines"/>
            <dg:DataGrid ui:field="dataGrid" tableName="Pipelines"/>
        </dg:PagerPanel>
    </v:QuickFilterPage>
</ui:UiBinder>
