<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- The content of the dialog that edits one check (check-editor.css): whether it is off, advice
     or a gate, its threshold where it has one, then its own settings, one panel shown at a time -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:form="urn:import:stroom.widget.form.client"
             xmlns:l="urn:import:stroom.widget.selection.client"
             xmlns:tickbox="urn:import:stroom.widget.tickbox.client"
             xmlns:v="urn:import:stroom.widget.valuespinner.client"
             xmlns:s="urn:import:stroom.learningflow.client.component">
    <g:FlowPanel styleName="max form-padding form check-editor">
        <form:FormGroup identity="checkState"
                        label="State"
                        helpText="Off: not run. Advice: run, shown beside a new translation and told to the AI, but it never refuses one; a step's rule that names it still fires. Gate: a new translation that falls below its threshold is refused, and where the check judges records, a served record that fails it is held back and the feed learns again.">
            <l:SelectionBox ui:field="state"/>
        </form:FormGroup>
        <form:FormGroup ui:field="thresholdGroup"
                        identity="checkThreshold"
                        label="Threshold"
                        helpText="The score, from 0 to 1, below which an answer falls short of this check."
                        screenReaderText="A number from 0 to 1.">
            <form:TextBox ui:field="threshold" addStyleNames="check-editor__number"/>
        </form:FormGroup>

        <!-- Yield -->
        <g:FlowPanel ui:field="yieldParameters" styleName="form">
            <form:FormGroup identity="yieldExpectedRatio"
                            label="Expected ratio"
                            helpText="Output records expected per unit of input. One per input record for a transformation; an extraction stage sets what its data yields."
                            screenReaderText="A number above zero.">
                <form:TextBox ui:field="expectedRatio" addStyleNames="check-editor__number"/>
            </form:FormGroup>
            <form:FormGroup identity="yieldBasis"
                            label="Per"
                            helpText="What output records are counted against: input records for a transformation stage, lines or bytes for an extraction stage.">
                <l:SelectionBox ui:field="basis"/>
            </form:FormGroup>
        </g:FlowPanel>
        <!-- Extraction quality -->
        <g:FlowPanel ui:field="extractionQualityParameters" styleName="form">
            <form:FormGroup helpText="Whether records classified as Unknown are tolerated. They never count toward a passing score either way.">
                <tickbox:TickBox ui:field="allowUnknownEventDetail"
                                 identity="qualityAllowUnknownEventDetail"
                                 label="Allow Unknown event detail"/>
            </form:FormGroup>
            <form:FormGroup identity="qualityRequiredFields"
                            label="Required fields"
                            helpText="XPaths, one per line, that every record must populate, e.g. /Event/EventSource/User/Id."
                            screenReaderText="One XPath per line.">
                <form:TextArea ui:field="requiredFields" addStyleNames="check-editor__lines"/>
            </form:FormGroup>
        </g:FlowPanel>
        <!-- Time plausibility -->
        <g:FlowPanel ui:field="timesParameters" styleName="form">
            <form:FormGroup identity="timesBeforeDays"
                            label="Days before the stream was received"
                            helpText="How long before its stream arrived an event may be dated. A year allows for a stream being loaded from an archive.">
                <v:ValueSpinner ui:field="beforeDays" addStyleNames="value-spinner--narrow"
                                minValue="0" maxValue="36500"/>
            </form:FormGroup>
            <form:FormGroup identity="timesAfterDays"
                            label="Days after it"
                            helpText="How long after its stream arrived an event may be dated. A day allows for a clock a little ahead.">
                <v:ValueSpinner ui:field="afterDays" addStyleNames="value-spinner--narrow"
                                minValue="0" maxValue="36500"/>
            </form:FormGroup>
            <form:FormGroup identity="timesTimeField"
                            label="Time field"
                            helpText="An XPath, from a record, to the time to judge. Leave it empty for event-logging's EventTime/TimeCreated; for another target schema the check doesn't run until it names one.">
                <form:TextBox ui:field="timeField" addStyleNames="check-editor__text"
                              placeholder="EventTime/TimeCreated"/>
            </form:FormGroup>
        </g:FlowPanel>
        <!-- Business rules -->
        <g:FlowPanel ui:field="businessRulesParameters" styleName="form">
            <form:FormGroup identity="rulesAssertions"
                            label="Assertions"
                            helpText="XPaths every record must satisfy."
                            addStyleNames="dock-max">
                <g:SimplePanel addStyleNames="control-box dock-container-vertical check-editor__assertions">
                    <s:XPathAssertionList ui:field="assertions"/>
                </g:SimplePanel>
            </form:FormGroup>
            <form:FormGroup helpText="A warning or error the transform raises itself with xsl:message about a record counts as a failed rule for that record.">
                <tickbox:TickBox ui:field="includeTransformMessages"
                                 identity="rulesIncludeTransformMessages"
                                 label="Count transform messages"/>
            </form:FormGroup>
        </g:FlowPanel>
    </g:FlowPanel>
</ui:UiBinder>
