<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- Which feeds a Learning Flow document's Feeds tab lists (feed-filter-editor.css): by where they stand, with
     how many stand there, and whether those whose pipeline was deleted are shown -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:form="urn:import:stroom.widget.form.client"
             xmlns:l="urn:import:stroom.widget.selection.client"
             xmlns:t="urn:import:stroom.widget.tickbox.client">
    <g:FlowPanel styleName="max form feed-filter-editor">
        <form:FormGroup identity="learningFlowFeedFilter"
                        label="Where it stands"
                        helpText="Which pipelines to list, by where their learning stands. The number beside each is how many pipelines stand there.">
            <l:SelectionBox ui:field="filter" addStyleNames="feed-filter-editor__filter"/>
        </form:FormGroup>
        <form:FormGroup identity="learningFlowFeedShowDeleted"
                        helpText="A deleted pipeline's learning is kept to be read until it ages out. Left unticked, it is not listed.">
            <t:TickBox ui:field="showDeleted" addStyleNames="allow-focus" label="Show deleted pipelines"/>
        </form:FormGroup>
    </g:FlowPanel>
</ui:UiBinder>
