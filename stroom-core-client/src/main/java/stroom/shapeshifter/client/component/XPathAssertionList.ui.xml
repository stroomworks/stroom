<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- A business rules scorer's assertions, a row each, with Add, Edit, Remove and a pager -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:b="urn:import:stroom.widget.button.client"
             xmlns:dg="urn:import:stroom.widget.datagrid.client">
    <dg:PagerPanel toolbarName="Assertion actions">
        <b:ToolbarButton ui:field="addButton" svg="ADD" title="Add assertion"/>
        <b:ToolbarButton ui:field="editButton" svg="EDIT" title="Edit selected assertion" enabled="false"/>
        <b:ToolbarButton ui:field="removeButton" svg="DELETE" title="Remove selected assertion" enabled="false"/>
        <dg:DataGrid ui:field="dataGrid" tableName="Assertions"/>
    </dg:PagerPanel>
</ui:UiBinder>
