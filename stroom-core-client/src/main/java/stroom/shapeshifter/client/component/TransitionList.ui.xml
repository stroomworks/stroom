<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- Where one step goes, outcome by outcome, with Add, Edit and Remove -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:b="urn:import:stroom.widget.button.client"
             xmlns:dg="urn:import:stroom.widget.datagrid.client">
    <dg:PagerPanel toolbarName="Transition actions">
        <b:ToolbarButton ui:field="addButton" svg="ADD" title="Add transition"/>
        <b:ToolbarButton ui:field="editButton" svg="EDIT" title="Edit selected transition" enabled="false"/>
        <b:ToolbarButton ui:field="removeButton" svg="DELETE" title="Remove selected transition" enabled="false"/>
        <dg:DataGrid ui:field="dataGrid" tableName="Transitions"/>
    </dg:PagerPanel>
</ui:UiBinder>
