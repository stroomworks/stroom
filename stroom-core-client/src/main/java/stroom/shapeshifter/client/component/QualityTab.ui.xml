<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- A Smart Pipeline's Quality Assurance tab (quality-tab.css): which of its AI Translator elements, where it has
     more than one; then the figures its translation is judged by, its volume day by day, what its records became,
     samples of them beside what they became, and each learning run's score; or why there is nothing to judge -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:c="urn:import:stroom.widget.component.client"
             xmlns:dg="urn:import:stroom.widget.datagrid.client"
             xmlns:form="urn:import:stroom.widget.form.client"
             xmlns:l="urn:import:stroom.widget.selection.client"
             xmlns:tx="urn:import:stroom.widget.text.client"
             xmlns:s="urn:import:stroom.shapeshifter.client.component">
    <g:FlowPanel styleName="max quality-tab">
        <g:FlowPanel ui:field="chooser" styleName="form quality-tab__chooser" visible="false">
            <form:FormGroup identity="shapeshifterAiQualityElement" label="AI Translator element"
                            helpText="This pipeline has more than one AI Translator element. Each learns its own translation, judged on its own.">
                <l:SelectionBox ui:field="element" addStyleNames="quality-tab__element"/>
            </form:FormGroup>
        </g:FlowPanel>
        <tx:Label ui:field="nothing" styleName="quality-tab__nothing" visible="false"/>
        <g:FlowPanel ui:field="content" styleName="quality-tab__content">
            <g:HTMLPanel styleName="quality-tab__head">
                <h2 class="quality-tab__title">Quality now</h2>
                <span class="quality-tab__question">The figures the translation in use is judged by, without
                    reading every record</span>
            </g:HTMLPanel>
            <tx:Label ui:field="message" styleName="quality-tab__message"/>
            <c:AriaPanel ui:field="figures" styleName="quality-tab__figures" role="list"
                         ariaLabel="Quality figures"/>

            <g:HTMLPanel styleName="quality-tab__head">
                <h2 class="quality-tab__title">Volume</h2>
                <span class="quality-tab__question">Streams and records translated each day of the last
                    fortnight (UTC)</span>
            </g:HTMLPanel>
            <tx:Label ui:field="volumeSummary" styleName="quality-tab__message"/>
            <tx:Html ui:field="volumeChart" styleName="quality-tab__chart"/>
            <s:Disclosure text="Day by day">
                <g:SimplePanel styleName="quality-tab__days dock-container-vertical">
                    <dg:DataGrid ui:field="days" tableName="Volume by day"/>
                </g:SimplePanel>
            </s:Disclosure>

            <g:HTMLPanel styleName="quality-tab__head">
                <h2 class="quality-tab__title">What its records became</h2>
                <span class="quality-tab__question">The cardinality of the translation in use: the records it
                    was learned and checked on, by what each became</span>
            </g:HTMLPanel>
            <tx:Label ui:field="cardinalityNote" styleName="quality-tab__message"/>
            <c:AriaPanel ui:field="cardinality" styleName="quality-tab__figures" role="list"
                         ariaLabel="What its records became"/>

            <g:HTMLPanel styleName="quality-tab__head">
                <h2 class="quality-tab__title">Samples</h2>
                <span class="quality-tab__question">Records the translation in use was learned and checked on,
                    beside what they became, newest first</span>
            </g:HTMLPanel>
            <tx:Label ui:field="samplesNote" styleName="quality-tab__message"/>
            <c:AriaPanel ui:field="samples" styleName="quality-tab__samples" role="list" ariaLabel="Samples"/>

            <g:HTMLPanel styleName="quality-tab__head">
                <h2 class="quality-tab__title">Learning runs</h2>
                <span class="quality-tab__question">What each learning run scored on the stream it learned from,
                    newest first</span>
            </g:HTMLPanel>
            <g:SimplePanel styleName="quality-tab__runs dock-container-vertical">
                <dg:DataGrid ui:field="runs" tableName="Learning runs"/>
            </g:SimplePanel>
        </g:FlowPanel>
    </g:FlowPanel>
</ui:UiBinder>
