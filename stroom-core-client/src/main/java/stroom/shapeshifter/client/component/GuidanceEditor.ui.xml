<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- Everything a supervisor has said to one learner (A46, A128), bordered, with saying another and taking one
     back -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:b="urn:import:stroom.widget.button.client"
             xmlns:dg="urn:import:stroom.widget.datagrid.client">
    <dg:PagerPanel ui:field="pager" toolbarName="Guidance actions" addStyleNames="control-box">
        <b:ToolbarButton ui:field="addButton" svg="ADD" title="Tell this learner something else"/>
        <b:ToolbarButton ui:field="removeButton" svg="DELETE"
                         title="Take this back, so that it stops being carried" enabled="false"/>
        <dg:DataGrid ui:field="dataGrid" tableName="Shapeshifter AI Guidance" multiLine="true"/>
    </dg:PagerPanel>
</ui:UiBinder>
