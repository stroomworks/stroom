<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- One session's conversation, turn by turn (A28), every turn on one page (A116) -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:b="urn:import:stroom.widget.button.client"
             xmlns:dg="urn:import:stroom.widget.datagrid.client">
    <dg:PagerPanel ui:field="pager" toolbarName="Turn actions">
        <b:ToolbarButton ui:field="answerButton" svg="EDIT"
                         title="Answer this turn instead, or edit its answer and run the attempt again from here"
                         enabled="false"/>
        <dg:DataGrid ui:field="dataGrid" tableName="Turns" pageSize="100000" multiLine="true"/>
    </dg:PagerPanel>
</ui:UiBinder>
