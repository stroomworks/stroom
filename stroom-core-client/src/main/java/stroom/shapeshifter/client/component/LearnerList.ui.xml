<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- The Supervisor's learning pipelines (design 06 A115), with the actions on a pipeline's learner and on
     the binding it shows serving (A141) -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:b="urn:import:stroom.widget.button.client"
             xmlns:dg="urn:import:stroom.widget.datagrid.client">
    <dg:PagerPanel ui:field="pager" toolbarName="Learning pipeline actions">
        <b:ToolbarButton ui:field="filterButton" svg="FILTER" title="Narrow which learning pipelines are shown"/>
        <b:ToolbarButton ui:field="relearnButton" svg="UNDO"
                         title="Learn again: the next stream opens a session while the binding goes on serving it"
                         enabled="false"/>
        <b:ToolbarButton ui:field="giveUpButton" svg="STOP"
                         title="Give this learner up: it learns no more, and its streams nothing serves error"
                         enabled="false"/>
        <b:ToolbarButton ui:field="guidanceButton" svg="EDIT"
                         title="What has been said to this learner, and say something else" enabled="false"/>
        <b:ToolbarButton ui:field="improveButton" svg="RERUN"
                         title="Ask for this binding to be made better, from what it already does" enabled="false"/>
        <b:ToolbarButton ui:field="acceptButton" svg="TICK"
                         title="Accept this provisional binding now, without waiting for records to judge it on"
                         enabled="false"/>
        <b:ToolbarButton ui:field="openButton" svg="OPEN" title="Open this binding's fragment" enabled="false"/>
        <b:ToolbarButton ui:field="retractButton" svg="DISABLE"
                         title="Take this binding back: it stops serving and its learner learns again"
                         enabled="false"/>
        <dg:DataGrid ui:field="dataGrid" tableName="Shapeshifter AI Learning Pipelines"/>
    </dg:PagerPanel>
</ui:UiBinder>
