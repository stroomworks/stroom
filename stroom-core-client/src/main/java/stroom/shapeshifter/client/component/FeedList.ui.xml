<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- The feeds a Shapeshifter AI document learns and translates, on its Feeds tab (feed-list.css): which to show,
     and a row each saying where it stands -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:b="urn:import:stroom.widget.button.client"
             xmlns:dg="urn:import:stroom.widget.datagrid.client"
             xmlns:form="urn:import:stroom.widget.form.client"
             xmlns:l="urn:import:stroom.widget.selection.client"
             xmlns:t="urn:import:stroom.widget.tickbox.client">
    <g:FlowPanel styleName="max dock-container-vertical feed-list">
        <g:FlowPanel styleName="dock-min form form-padding feed-list__tools">
            <form:FormGroup identity="shapeshifterAiFeedFilter" label="Show">
                <l:SelectionBox ui:field="filter" addStyleNames="w-100"/>
            </form:FormGroup>
            <t:TickBox ui:field="showDeleted" label="Feeds whose pipeline was deleted"/>
        </g:FlowPanel>
        <dg:PagerPanel ui:field="pager" toolbarName="Feed list actions" addStyleNames="dock-max">
            <b:ToolbarToggleButton ui:field="autoRefreshButton" svg="AUTO_REFRESH"
                                   title="Auto Refresh: read the feeds again every ten seconds" pressed="true"/>
            <dg:DataGrid ui:field="dataGrid" tableName="Feeds"/>
        </dg:PagerPanel>
    </g:FlowPanel>
</ui:UiBinder>
