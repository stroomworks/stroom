<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- The permitted destinations, with their actions and a pager above their grid -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:b="urn:import:stroom.widget.button.client"
             xmlns:dg="urn:import:stroom.widget.datagrid.client">
    <dg:PagerPanel toolbarName="Egress rule actions" addStyleNames="default-min-sizes">
        <b:ToolbarButton ui:field="newButton" svg="ADD" title="New Rule"/>
        <b:ToolbarButton ui:field="editButton" svg="EDIT" title="Edit Selected Rule" enabled="false"/>
        <b:ToolbarButton ui:field="deleteButton" svg="DELETE" title="Delete Selected Rule" enabled="false"/>
        <b:ToolbarButton ui:field="refreshButton" svg="REFRESH" title="Read the rules again"/>
        <dg:DataGrid ui:field="dataGrid" tableName="Egress rules"/>
    </dg:PagerPanel>
</ui:UiBinder>
