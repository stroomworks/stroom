<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- A StroomQL query's text: its help beside its editor -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:q="urn:import:stroom.query.client.component"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:split="urn:import:stroom.widget.layout.client"
             xmlns:ed="urn:import:stroom.editor.client.component">
    <split:SplitPane thin="true" sizes="300px, *"
                     names="Help, Query" addStyleNames="max">
        <g:SimplePanel styleName="max">
            <q:QueryHelp ui:field="queryHelp"/>
        </g:SimplePanel>
        <g:SimplePanel styleName="max overflow-hidden">
            <ed:CodeEditor ui:field="editor"/>
        </g:SimplePanel>
    </split:SplitPane>
</ui:UiBinder>
