<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- A StroomQL query: its help beside the editor, above the results as a table or a visualisation -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:q="urn:import:stroom.query.client.component"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:split="urn:import:stroom.widget.layout.client"
             xmlns:tab="urn:import:stroom.widget.tab.client"
             xmlns:c="urn:import:stroom.widget.component.client">
    <split:SplitPane vertical="true" thin="true" sizes="600px, *"
                     names="Query, Results" addStyleNames="query-editor max">
        <q:StroomQLEditor ui:field="editor"/>
        <g:SimplePanel styleName="max">
            <g:FlowPanel styleName="query-editor__results max dock-container-vertical">
                <g:SimplePanel styleName="query-editor__results-outer">
                    <tab:LinkTabBar ui:field="tabBar" addStyleNames="dock-min"/>
                </g:SimplePanel>
                <c:LayerContainer ui:field="layerContainer" styleName="dock-max"/>
            </g:FlowPanel>
        </g:SimplePanel>
    </split:SplitPane>
</ui:UiBinder>
