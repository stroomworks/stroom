<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui">
    <!-- The FocusPanel is the map's keyboard host: GWT gives it tabindex="0", and
         the presenter binds pan/zoom/traversal keys to it. It therefore needs a
         focus ring of its own, which stroom-floormap.css draws off this class. -->
    <g:FocusPanel ui:field="focusPanel" styleName="max"
                  addStyleNames="stroom-floormap-canvas-focus">
        <g:FlowPanel addStyleNames="max stroom-floormap-canvas-container">
            <g:HTML ui:field="svgContainer" addStyleNames="max"/>
            <g:Label ui:field="areaDrawHint" addStyleNames="stroom-floormap-area-draw-hint"/>
            <!-- Follows the cursor during a move or resize, reporting the
                 position or size being dragged out in real-world units. -->
            <g:Label ui:field="gestureReadout" addStyleNames="stroom-floormap-gesture-readout"/>
            <!-- Describes the glyph under the pointer: the members of a cluster,
                 or one entity's details. Anchored to the glyph rather than the
                 cursor: a panel that slid about while the pointer moved across a
                 single glyph would read as unstable, and a fixed anchor lets the
                 contents be rebuilt only when the hovered glyph changes. -->
            <g:FlowPanel ui:field="hoverTooltip"
                         addStyleNames="stroom-floormap-hover-tooltip"/>
            <!-- Always-on scale bar: the origin indicator only helps while (0,0)
                 is on screen, which is not the normal state of a map being read. -->
            <g:FlowPanel ui:field="scaleBar" addStyleNames="stroom-floormap-scale-bar">
                <g:Label ui:field="scaleBarLabel"
                         addStyleNames="stroom-floormap-scale-bar__label"/>
                <g:SimplePanel ui:field="scaleBarLine"
                               addStyleNames="stroom-floormap-scale-bar__line"/>
            </g:FlowPanel>
            <!-- The map's spoken commentary: selection, tracking, time changes and
                 entities leaving the timeline range. Everything the canvas says
                 visually is otherwise invisible to a screen reader, because the SVG
                 is marked aria-hidden (its text captions are laid out for the eye
                 and read as noise in DOM order).

                 Visually hidden rather than display:none — a hidden live region is
                 removed from the accessibility tree and never announces. -->
            <g:Label ui:field="statusRegion"
                     addStyleNames="stroom-floormap-visually-hidden"/>
        </g:FlowPanel>
    </g:FocusPanel>
</ui:UiBinder>
