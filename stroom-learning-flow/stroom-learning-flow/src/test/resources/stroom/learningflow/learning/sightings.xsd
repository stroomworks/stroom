<!--
  A second schema, so that the generated structural summary (task 7, decision D2 option G) is held to a
  schema that is not event-logging. Small, but with the shapes that matter: a root holding a repeating
  record, required children in order, an optional one, a choice, and an enumeration.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:s="urn:sightings:2"
           targetNamespace="urn:sightings:2"
           elementFormDefault="qualified"
           version="2.4">

   <xs:element name="Sightings">
      <xs:complexType>
         <xs:sequence>
            <xs:element ref="s:Sighting" maxOccurs="unbounded"/>
         </xs:sequence>
         <xs:attribute name="Version" type="xs:string" use="required"/>
      </xs:complexType>
   </xs:element>

   <xs:element name="Sighting">
      <xs:complexType>
         <xs:sequence>
            <xs:element name="When" type="xs:dateTime"/>
            <xs:element ref="s:Where"/>
            <xs:choice>
               <xs:element name="Bird" type="s:SpeciesType"/>
               <xs:element name="Mammal" type="s:SpeciesType"/>
            </xs:choice>
            <xs:element name="Observer" type="xs:string" minOccurs="0"/>
         </xs:sequence>
      </xs:complexType>
   </xs:element>

   <xs:element name="Where">
      <xs:complexType>
         <xs:sequence>
            <xs:element name="Grid" type="xs:string"/>
            <xs:element name="Habitat" type="s:HabitatType"/>
         </xs:sequence>
      </xs:complexType>
   </xs:element>

   <xs:complexType name="SpeciesType">
      <xs:sequence>
         <xs:element name="Species" type="xs:string"/>
         <xs:element name="Count" type="xs:int" minOccurs="0"/>
      </xs:sequence>
   </xs:complexType>

   <xs:simpleType name="HabitatType">
      <xs:restriction base="xs:string">
         <xs:enumeration value="woodland"/>
         <xs:enumeration value="wetland"/>
         <xs:enumeration value="coastal"/>
      </xs:restriction>
   </xs:simpleType>

</xs:schema>
