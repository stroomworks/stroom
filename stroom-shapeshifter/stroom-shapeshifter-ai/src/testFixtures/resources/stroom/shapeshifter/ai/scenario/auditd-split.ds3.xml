<?xml version="1.0" encoding="UTF-8"?>
<dataSplitter
    xmlns="data-splitter:3"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="data-splitter:3 file://data-splitter-v3.0.xsd"
    version="3.0">

  <!-- The record boundary and nothing else: one record per run of consecutive lines sharing one
       msg=audit(time:serial), the run as one field, however many lines it spans -->
  <regex pattern="^(node=\S+ type=\w+ msg=audit\(([\d.]+):(\d+)\):.*(?:\n(?=node=\S+ type=\w+ msg=audit\(\2:\3\)).*)*)\n?">
    <data name="record" value="$1"/>
  </regex>
</dataSplitter>
