<?xml version="1.0" encoding="UTF-8"?>
<dataSplitter
    xmlns="data-splitter:3"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="data-splitter:3 file://data-splitter-v3.0.xsd"
    version="3.0">
  <!-- Four columns by position; the rest of the line is matched and dropped, so every character is consumed -->
  <split delimiter="\n">
    <group value="$1">
      <regex pattern="^(.{14})(.{8})(.{8})(.{8}).*$">
        <data name="time" value="$1"/>
        <data name="user" value="$2"/>
        <data name="terminal" value="$3"/>
        <data name="action" value="$4"/>
      </regex>
    </group>
  </split>
</dataSplitter>
