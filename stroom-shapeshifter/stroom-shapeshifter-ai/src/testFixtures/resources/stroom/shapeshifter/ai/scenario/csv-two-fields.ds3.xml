<?xml version="1.0" encoding="UTF-8"?>
<dataSplitter
    xmlns="data-splitter:3"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="data-splitter:3 file://data-splitter-v3.0.xsd"
    version="3.0">

  <!-- Consumes every line and keeps two of its four fields: full coverage, half the record lost -->
  <split delimiter="\n">
    <group value="$1">
      <regex pattern="^([^,]+),([^,]+),.*$">
        <data name="dt" value="$1"/>
        <data name="who" value="$2"/>
      </regex>
    </group>
  </split>
</dataSplitter>
