<?xml version="1.0" encoding="UTF-8"?>
<dataSplitter
    xmlns="data-splitter:3"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="data-splitter:3 file://data-splitter-v3.0.xsd"
    version="3.0">

  <!-- One record per block between separator lines, the block as one field, however many lines it spans -->
  <split delimiter="----\n">
    <group value="$1">
      <regex pattern="^(?s)\s*(.+?)\s*$">
        <data name="record" value="$1"/>
      </regex>
    </group>
  </split>
</dataSplitter>
